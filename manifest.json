{
  "id": "baby-log",
  "contexts": ["household", "shared_space"],
  "name": "Baby Log",
  "version": "1.0.0",
  "description": "Track feeds, diapers, naps, and pumping for your baby — quick one-tap logging, a running sleep timer, and a daily summary every caregiver can see.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "family",
  "tags": ["baby", "newborn", "feeding", "sleep", "diapers", "parenting"],
  "icon": "🍼",
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "db_plaintext_columns": ["entry_type", "birth_date"],
  "row_policies": {
    "babies": {
      "kind": "adult_writable"
    },
    "entries": {
      "kind": "adult_writable",
      "retain_days": {
        "default": 730,
        "timestamp_column": "started_at"
      }
    }
  },
  "member_references": {
    "babies": {
      "column": "created_by",
      "on_removed": "keep"
    },
    "entries": {
      "column": "created_by",
      "on_removed": "keep"
    }
  },
  "publishes": ["baby.entry_logged"],
  "publish_acls": {
    "baby.entry_logged": { "require_role": "adult" }
  },
  "nav": { "label": "Baby Log" },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT b.name AS title, e.entry_type AS subtitle, e.started_at AS at FROM app_baby_log__entries e JOIN app_baby_log__babies b ON b.id = e.baby_id WHERE b.archived = 0 ORDER BY e.started_at DESC LIMIT 3"
    },
    "display": { "template": "list", "title": "title", "subtitle": "subtitle", "when": "at" }
  },
  "resource_limits": {
    "max_db_bytes": 52428800
  },
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["recent_entries", "babies"]
  }
}
