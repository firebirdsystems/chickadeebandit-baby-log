{
  "scenarios": [
    {
      "name": "a parent turns on the feed reminder for one child and it stays on after a reload; the log says when it falls due (a feed half an hour ago, so the reminder is ahead), to the nanny too, who has no Reminders tab",
      "members": {
        "parent": "adult",
        "nanny": "guest"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_baby_log__babies (id, name, birth_date, emoji, archived, created_by, created_at) VALUES ('b1', 'Juniper', '2026-01-01', '👶', 0, ?, '2026-01-01T00:00:00Z')",
          "params": [
            "{{parent}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_baby_log__entries (id, baby_id, entry_type, started_at, local_at, ended_at, amount_ml, feed_kind, diaper_kind, note, created_by, created_by_name, created_at) VALUES ('f1', 'b1', 'feed', strftime('%Y-%m-%dT%H:%M:%fZ', 'now', '-30 minutes'), '', NULL, 120, 'bottle', '', '', ?, 'Alex', strftime('%Y-%m-%dT%H:%M:%fZ', 'now', '-30 minutes'))",
          "params": [
            "{{parent}}"
          ]
        },
        {
          "action": "open",
          "as": "parent"
        },
        {
          "action": "expectCount",
          "as": "parent",
          "selector": "[data-testid=\"next-reminders\"]",
          "count": 0
        },
        {
          "action": "click",
          "as": "parent",
          "selector": "[data-testid=\"tab-reminders\"]"
        },
        {
          "action": "expectVisible",
          "as": "parent",
          "selector": "[data-testid=\"reminders-form\"]"
        },
        {
          "action": "select",
          "as": "parent",
          "selector": "#rem-feed",
          "value": "180"
        },
        {
          "action": "click",
          "as": "parent",
          "selector": "[data-testid=\"reminders-save\"]"
        },
        {
          "action": "expectVisible",
          "as": "parent",
          "selector": "[data-testid=\"reminders-save\"]:not([disabled])"
        },
        {
          "action": "reload",
          "as": "parent"
        },
        {
          "action": "expectText",
          "as": "parent",
          "selector": "[data-testid=\"next-reminders\"]",
          "text": "Feed reminder"
        },
        {
          "action": "expectNoText",
          "as": "parent",
          "selector": "[data-testid=\"next-reminders\"]",
          "text": "Wake window"
        },
        {
          "action": "open",
          "as": "nanny"
        },
        {
          "action": "expectText",
          "as": "nanny",
          "selector": "[data-testid=\"next-reminders\"]",
          "text": "Feed due"
        },
        {
          "action": "expectCount",
          "as": "nanny",
          "selector": "[data-testid=\"tab-reminders\"]",
          "count": 0
        }
      ]
    },
    {
      "name": "in a shared space the Reminders tab says they are sent from a household's own Baby Log and offers no settings",
      "context": "shared_space",
      "members": {
        "steward": "admin",
        "parent": "adult"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_baby_log__babies (id, name, birth_date, emoji, archived, created_by, created_at) VALUES ('b1', 'Juniper', '2026-01-01', '👶', 0, ?, '2026-01-01T00:00:00Z')",
          "params": [
            "{{parent}}"
          ]
        },
        {
          "action": "open",
          "as": "parent"
        },
        {
          "action": "click",
          "as": "parent",
          "selector": "[data-testid=\"tab-reminders\"]"
        },
        {
          "action": "expectVisible",
          "as": "parent",
          "selector": "[data-testid=\"reminders-unsupported\"]"
        },
        {
          "action": "expectCount",
          "as": "parent",
          "selector": "[data-testid=\"reminders-form\"]",
          "count": 0
        }
      ]
    },
    {
      "name": "the nanny gives a medicine and the parent's log says when the next dose may be given; a temperature typed in the wrong units is refused, and a fever is marked; a repeat dose is one tap on the medicine given before, and the form shows the wait it is still inside; the one-tap Sleep button still starts a nap; a dose the nanny logs while the parent's form is open is shown before the parent's saves",
      "members": {
        "parent": "adult",
        "nanny": "guest"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_baby_log__babies (id, name, birth_date, emoji, archived, created_by, created_at) VALUES ('b1', 'Juniper', '2026-01-01', '👶', 0, ?, '2026-01-01T00:00:00Z')",
          "params": [
            "{{parent}}"
          ]
        },
        {
          "action": "open",
          "as": "nanny"
        },
        {
          "action": "expectCount",
          "as": "nanny",
          "selector": "[data-testid=\"health-line\"]",
          "count": 0
        },
        {
          "action": "click",
          "as": "nanny",
          "selector": "[data-quick=\"medicine\"]"
        },
        {
          "action": "fill",
          "as": "nanny",
          "selector": "#f-medname",
          "value": "Infant Tylenol"
        },
        {
          "action": "fill",
          "as": "nanny",
          "selector": "#f-meddose",
          "value": "2.5 ml"
        },
        {
          "action": "select",
          "as": "nanny",
          "selector": "#f-repeat",
          "value": "240"
        },
        {
          "action": "click",
          "as": "nanny",
          "selector": "#entry-form button[type=\"submit\"]"
        },
        {
          "action": "expectText",
          "as": "nanny",
          "selector": "[data-testid=\"health-line\"]",
          "text": "Infant Tylenol 2.5 ml at"
        },
        {
          "action": "open",
          "as": "parent"
        },
        {
          "action": "expectText",
          "as": "parent",
          "selector": "[data-testid=\"health-line\"]",
          "text": "not again before"
        },
        {
          "action": "click",
          "as": "parent",
          "selector": "[data-view=\"growth\"]"
        },
        {
          "action": "click",
          "as": "parent",
          "selector": "[data-units=\"metric\"]"
        },
        {
          "action": "click",
          "as": "parent",
          "selector": "[data-view=\"log\"]"
        },
        {
          "action": "click",
          "as": "parent",
          "selector": "[data-quick=\"temperature\"]"
        },
        {
          "action": "fill",
          "as": "parent",
          "selector": "#f-temp",
          "value": "101.2"
        },
        {
          "action": "click",
          "as": "parent",
          "selector": "#entry-form button[type=\"submit\"]"
        },
        {
          "action": "expectText",
          "as": "parent",
          "selector": "[data-testid=\"modal-error\"]",
          "text": "looks wrong"
        },
        {
          "action": "fill",
          "as": "parent",
          "selector": "#f-temp",
          "value": "38.6"
        },
        {
          "action": "select",
          "as": "parent",
          "selector": "#f-method",
          "value": "armpit"
        },
        {
          "action": "click",
          "as": "parent",
          "selector": "#entry-form button[type=\"submit\"]"
        },
        {
          "action": "expectText",
          "as": "parent",
          "selector": "[data-testid=\"health-line\"]",
          "text": "Last temperature 38.6 °C, fever"
        },
        {
          "action": "click",
          "as": "parent",
          "selector": "[data-quick=\"medicine\"]"
        },
        {
          "action": "click",
          "as": "parent",
          "selector": "[data-med-fill=\"0\"]"
        },
        {
          "action": "expectCount",
          "as": "parent",
          "selector": "#f-repeat option:checked[value=\"240\"]",
          "count": 1
        },
        {
          "action": "expectText",
          "as": "parent",
          "selector": "[data-testid=\"dose-wait\"]",
          "text": "not again before"
        },
        {
          "action": "click",
          "as": "parent",
          "selector": "#entry-form button[type=\"submit\"]"
        },
        {
          "action": "expectCount",
          "as": "parent",
          "selector": ".entry-title:has-text(\"Medicine\")",
          "count": 2
        },
        {
          "action": "click",
          "as": "parent",
          "selector": "[data-quick=\"medicine\"]"
        },
        {
          "action": "fill",
          "as": "parent",
          "selector": "#f-medname",
          "value": "Saline drops"
        },
        {
          "action": "expectCount",
          "as": "parent",
          "selector": "#f-repeat option:checked[value=\"\"]",
          "count": 1
        },
        {
          "action": "click",
          "as": "nanny",
          "selector": "[data-quick=\"medicine\"]"
        },
        {
          "action": "fill",
          "as": "nanny",
          "selector": "#f-medname",
          "value": "Saline drops"
        },
        {
          "action": "select",
          "as": "nanny",
          "selector": "#f-repeat",
          "value": "240"
        },
        {
          "action": "click",
          "as": "nanny",
          "selector": "#entry-form button[type=\"submit\"]"
        },
        {
          "action": "expectCount",
          "as": "nanny",
          "selector": "#entry-form",
          "count": 0
        },
        {
          "action": "click",
          "as": "parent",
          "selector": "#entry-form button[type=\"submit\"]"
        },
        {
          "action": "expectText",
          "as": "parent",
          "selector": "[data-testid=\"dose-wait\"]",
          "text": "not again before"
        },
        {
          "action": "expectCount",
          "as": "parent",
          "selector": "#f-repeat option:checked[value=\"\"]",
          "count": 1
        },
        {
          "action": "expectCount",
          "as": "parent",
          "selector": "#entry-form",
          "count": 1
        },
        {
          "action": "click",
          "as": "parent",
          "selector": "#entry-form button[type=\"submit\"]"
        },
        {
          "action": "expectCount",
          "as": "parent",
          "selector": "#entry-form",
          "count": 0
        },
        {
          "action": "click",
          "as": "parent",
          "selector": "[data-quick=\"sleep\"]"
        },
        {
          "action": "expectText",
          "as": "parent",
          "selector": "[data-quick=\"sleep\"]",
          "text": "End sleep"
        }
      ]
    }
  ]
}
