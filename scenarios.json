    {
      "name": "the AI exports return seeded babies and the entry log newest first",
      "members": {
        "parent": "adult"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_baby_log__babies (id, name, birth_date, archived, created_by, created_at) VALUES ('b1', 'Juniper', '2025-12-01', 0, ?, '2026-01-01T00:00:00Z')",
          "params": [
            "{{parent}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_baby_log__entries (id, baby_id, entry_type, started_at, ended_at, amount_ml, created_by, created_at) VALUES ('e_old', 'b1', 'sleep', '2026-01-02T01:00:00Z', '2026-01-02T03:00:00Z', NULL, ?, '2026-01-02T01:00:00Z'), ('e_new', 'b1', 'feed', '2026-01-02T05:00:00Z', NULL, 120, ?, '2026-01-02T05:00:00Z')",
          "params": [
            "{{parent}}",
            "{{parent}}"
          ]
        },
        {
          "action": "named",
          "as": "parent",
          "kind": "query",
          "name": "babies",
          "expect": {
            "status": 200,
            "rowCount": 1,
            "rowsContain": [
              {
                "id": "b1",
                "name": "Juniper",
                "birth_date": "2025-12-01"
              }
            ]
          }
        },
        {
          "action": "named",
          "as": "parent",
          "kind": "query",
          "name": "recent_entries",
          "expect": {
            "status": 200,
            "rowCount": 2,
            "rowsContain": [
              {
                "id": "e_new",
                "entry_type": "feed",
                "amount_ml": 120
              },
              {
                "id": "e_old",
                "entry_type": "sleep",
                "ended_at": "2026-01-02T03:00:00Z"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "every member who can log may publish baby.entry_logged, so a nanny's feed reaches automations too",
      "members": {
        "parent": "adult",
        "nanny": "guest",
        "sibling": "child"
      },
      "granted": [
        "nanny"
      ],
      "steps": [
        {
          "action": "publish",
          "as": "nanny",
          "type": "baby.entry_logged",
          "subject_id": "e1",
          "payload": {
            "baby_id": "b1",
            "entry_type": "feed",
            "started_at": "2026-01-02T08:00:00Z",
            "amount_ml": 90
          },
          "expect": {
            "status": 201
          }
        },
        {
          "action": "publish",
          "as": "sibling",
          "type": "baby.entry_logged",
          "subject_id": "e2",
          "payload": {
            "baby_id": "b1",
            "entry_type": "diaper",
            "started_at": "2026-01-02T09:00:00Z",
            "amount_ml": null
          },
          "expect": {
            "status": 201
          }
        },
        {
          "action": "publish",
          "as": "parent",
          "type": "baby.entry_logged",
          "subject_id": "e3",
          "payload": {
            "baby_id": "b1",
            "entry_type": "feed",
            "started_at": "2026-01-02T10:00:00Z",
            "amount_ml": 90
          },
          "expect": {
            "status": 201
          }
        }
      ]
    },
